# EPIC Configuration
# Copy this file to .env and fill in your values

# Default LLM provider: openai | anthropic | ollama
DEFAULT_PROVIDER=ollama

# Default model (provider-specific, leave empty for provider default)
# DEFAULT_MODEL=qwen3.5:4b

# --- API Keys (set the one for your provider) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama Settings ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:4b

# --- Server Settings ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- LLM Parameters ---
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=4096

# --- Code Execution ---
AUTO_EXECUTE_CODE=true
CODE_EXECUTION_TIMEOUT=30

# --- Logging ---
LOG_LEVEL=INFO
